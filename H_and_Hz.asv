function [H, HzC] = H_and_Hz(x, z, c, choice)
% Matrix H of functions of z and x and its z derivative times c.

dz=length(z);
%[n, dx]=size(x);

HcC=zeros(dz,dz);

switch choice

    case 'oneD_Linear'
        H=[z x];
        Hz=[0*z+1 0*x];

    case 'oneD_more'
        H=[z x x.^2];
        Hz=[0*z+1 0*x 0*x];

    case 'Linear_in_z'
        H=[1 z x BS(x.^2,10)]; 
        Hz=zeros(dz, dz+3);    
        for k=1:dz
            Hz(k,k+1)=1;       
        end
        
    case 'Linear_in_z_unbounded'
        H = [1, z, x, x.^2];   
        Hz = zeros(dz, dz+3);  
        for k = 1:dz
            Hz(k, k+1) = 1;   
        end

end

HzC=tensorprod(Hz,c,2,1);

end